# ============================================
# Maison Tia — Environment Variables
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================

# JWT Secret — Generate a strong random key (min 64 chars)
# Example: openssl rand -base64 64
JWT_SECRET=

# Admin credentials (used by AuthController)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/maisontia_db
DB_USERNAME=
DB_PASSWORD=

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=https://www.maisontia.com,http://localhost:5173
